# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Packaging / build output (e.g. PyInstaller builds of the desktop app)
build/
dist/
*.egg-info/
*.spec

# Test and coverage output
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# SQLite databases (app creates data/maintenance.db on first run; MAINT_DB may point elsewhere)
data/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Local environment settings
.env
.env.*

# Logs
*.log

# Editors and IDEs
.vscode/
.idea/
*.swp
*~

# OS files
Thumbs.db
ehthumbs.db
desktop.ini
.DS_Store

# Claude Code local settings
.claude/settings.local.json
